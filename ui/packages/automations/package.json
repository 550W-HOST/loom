{
  "name": "bb-plugin-automations",
  "version": "0.1.0",
  "description": "Loom-native Automations browser UI boundary.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./app.tsx",
      "types": "./app.tsx",
      "default": "./app.tsx"
    },
    "./panel": {
      "source": "./app.tsx",
      "types": "./app.tsx",
      "default": "./app.tsx"
    },
    "./detail-view": {
      "source": "./detail-view.tsx",
      "types": "./detail-view.tsx",
      "default": "./detail-view.tsx"
    },
    "./overview-view": {
      "source": "./overview-view.tsx",
      "types": "./overview-view.tsx",
      "default": "./overview-view.tsx"
    },
    "./client": {
      "source": "./src/client.ts",
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./runtime": {
      "source": "./src/runtime.tsx",
      "types": "./src/runtime.tsx",
      "default": "./src/runtime.tsx"
    },
    "./rpc-types": {
      "source": "./src/rpc-types.ts",
      "types": "./src/rpc-types.ts",
      "default": "./src/rpc-types.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "@bb/shared-ui": "workspace:*",
    "cronstrue": "^3.14.0",
    "react": "^19.0.0",
    "sonner": "^1.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  }
}
