# loom-host-daemon environment file — template.
#
# Install one copy per server as /etc/loom/daemon/<server-key>.env, where
# <server-key> is the same instance name used in the unit (systemd-escape of the
# server host):
#
#   install -m 0644 loom-host-daemon.env /etc/loom/daemon/builder-1.env
#   systemctl enable --now loom-host-daemon@builder-1
#
# The daemon needs exactly one thing: a reachable server URL (LOOM_SERVER_URL).
# Everything else has a safe default.

# --- the server this machine joins --------------------------------------
# Required. The URL a browser would open. Plain http:// is fine over the
# tailnet or loopback; use https:// when a reverse proxy terminates TLS for a
# name that is not on the tailnet.
LOOM_SERVER_URL=https://loom.example.com

# --- this machine's identity --------------------------------------------
# Display name shown in the UI's host list. Keep it stable and human-readable.
LOOM_HOST_NAME=builder-1

# File to persist the enrolled host id in. This is what makes the machine's
# identity survive a restart instead of enrolling a second host. The daemon
# writes a sibling `.cursor` file next to it for the replay position.
LOOM_DAEMON_STATE=/var/lib/loom/machines/builder-1/host-id

# Base directory for per-thread provider sessions (Pi resumes a conversation
# from here). Optional.
LOOM_SESSION_DIR=/var/lib/loom/machines/builder-1/sessions

# --- liveness and limits ------------------------------------------------
# Heartbeat interval; must stay well below the server's staleness threshold.
LOOM_HEARTBEAT_MS=15000
# Kill a provider that has not settled within this many milliseconds.
LOOM_RUN_TIMEOUT_MS=1800000

# --- provider override --------------------------------------------------
# Normally unset: the daemon runs whatever provider the control plane
# dispatches. Set these only when the provider binary on this machine lives at a
# non-standard path or needs different arguments.
#LOOM_PROVIDER_CMD=/usr/local/bin/pi
#LOOM_PROVIDER_ARGS=--mode rpc --no-session

# --- self-update --------------------------------------------------------
# On by default: when the server speaks a newer protocol, the daemon fetches
# that server's own loom-daemon, verifies its SHA-256, installs it over this
# binary and exits so `Restart=always` starts it. See docs/upgrades.md.
#
# Set to 0 to control upgrades centrally instead. The refusal and the reason are
# logged, and the connection is retried; the binary is never replaced.
#LOOM_AUTO_UPDATE=0
