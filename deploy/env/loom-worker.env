# loom-worker environment file — template.
#
# Install one copy per server as /etc/loom/worker/<server-key>.env, where
# <server-key> is the same instance name used in the unit (systemd-escape of the
# server host):
#
#   install -m 0644 loom-worker.env /etc/loom/worker/builder-1.env
#   systemctl enable --now loom-worker@builder-1
#
# The worker needs exactly one thing: a reachable server URL (LOOM_SERVER_URL).
# Everything else has a safe default.

# --- the server this machine joins --------------------------------------
# Required. The URL a browser would open. Plain http:// is fine over the
# tailnet or loopback; use https:// when a reverse proxy terminates TLS for a
# name that is not on the tailnet.
LOOM_SERVER_URL=https://loom.example.com

# --- this machine's identity --------------------------------------------
# Display name shown in the UI's host list. Keep it stable and human-readable.
LOOM_HOST_NAME=builder-1

# File to persist the enrolled host id in. This is what makes the machine's
# identity survive a restart instead of enrolling a second host. The worker
# writes a sibling `.cursor` file next to it for the replay position.
LOOM_WORKER_STATE=/var/lib/loom/machines/builder-1/host-id

# Optional one-time enrollment capability from POST
# /api/v1/hosts/join-codes. Remove this after the first successful enrollment;
# it is deliberately not a durable credential and is never reused on reconnect.
#LOOM_JOIN_CODE=loom-...

# --- liveness and limits ------------------------------------------------
# Heartbeat interval; must stay well below the server's staleness threshold.
LOOM_HEARTBEAT_MS=15000
# Kill an ACP agent that has not settled within this many milliseconds.
LOOM_RUN_TIMEOUT_MS=1800000

# --- data directory -----------------------------------------------------
# Where this machine keeps its loom data. Thread storage lives here as
# <dir>/thread-storage/<thread_id>, and the server names it from what this
# worker reports at enrollment (threads.storageLocation and friends). Leave it
# unset for $HOME/.loom; set it explicitly when the worker runs as a service
# user whose home is not where the data should live.
#LOOM_DATA_DIR=/var/lib/loom/machines/builder-1/data

# --- provider override --------------------------------------------------
# Normally unset: the worker runs the ACP provider selected by the control
# plane. Set these only when the ACP agent binary on this machine lives at a
# non-standard path or needs different arguments.
#LOOM_PROVIDER_CMD=/usr/local/bin/my-acp-agent
#LOOM_PROVIDER_ARGS=--flag value

# --- self-update --------------------------------------------------------
# On by default: when the server speaks a newer protocol, the worker fetches the
# artifact that server hosts under the `loom-worker` name, verifies its SHA-256,
# installs it over this executable and exits so `Restart=always` starts it. See
# docs/upgrades.md.
#
# Set to 0 to control upgrades centrally instead. The refusal and the reason are
# logged, and the connection is retried; the binary is never replaced.
#LOOM_AUTO_UPDATE=0
