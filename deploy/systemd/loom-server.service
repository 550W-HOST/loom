# loom-server — the control plane.
#
# Install to /etc/systemd/system/loom-server.service.
# Configuration lives entirely in /etc/loom/loom-server.env; the unit passes no
# command-line flags, so the environment file is the single source of truth.
#
# The server is deliberately server-only: it never starts, supervises or waits
# for a worker. Stopping every worker on every execution machine cannot stop
# this unit, and stopping this unit cannot touch them.
[Unit]
Description=loom control plane (server + in-process relay)
Documentation=file:/usr/share/doc/loom/deploy/README.md https://github.com/550W-HOST/loom/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=loom
Group=loom
EnvironmentFile=/etc/loom/loom-server.env
# The role is explicit here. `/usr/local/bin/loom-server` — the symlink
# `deploy/install.sh` leaves beside this file — still works, because that is what
# anything spawning a binary by name uses (the worker's self-update restarts
# itself by its own path), but a unit is the one place the role is written down.
ExecStart=/usr/local/bin/loom server

# The relay log is the only thing the server needs from the filesystem: the
# binary carries the product app compiled into it, so there is no bundle path in
# this unit and nothing in the sandbox below has to exempt one.
# WorkingDirectory keeps any relative path in the environment file anchored.
WorkingDirectory=/var/lib/loom

Restart=on-failure
RestartSec=2s

# --- sandboxing ---------------------------------------------------------
# The control plane never executes a provider or a tool, so it can be locked
# down hard. This is the opposite of the worker unit, which must be able to
# write wherever the work is.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/loom
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

# --- resource limits (suggestions; size to the machine) -----------------
# The control plane is CPU-light and memory-bounded. These caps exist so that a
# degraded control plane is visible (cgroup pressure, OOM) instead of taking the
# whole host down. A 1 vCPU / 1 GiB box is enough to serve; leave headroom.
MemoryAccounting=true
MemoryHigh=1536M
MemoryMax=2G
CPUAccounting=true
CPUQuota=200%
TasksAccounting=true
TasksMax=512
LimitNOFILE=65536

# A server restart must never orphan a running relay log write; give it time to
# flush and close the disk backend.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
