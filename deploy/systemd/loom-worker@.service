# loom-worker@<server-key> — one execution machine joined to one server.
#
# Install to /etc/systemd/system/loom-worker@.service.
#
# Naming convention (kept from bb): the instance name is the *server key*, the
# systemd-escaped host of the server this machine joins. A machine that joins
# two servers (a lab box serving two control planes, or a migration) runs two
# independent instances, each with its own environment file and data directory:
#
#   loom-worker@loom.example.com.service
#     /etc/loom/worker/loom.example.com.env
#     /var/lib/loom/machines/loom.example.com/
#   loom-worker@lab.internal.service
#     /etc/loom/worker/lab.internal.env
#     /var/lib/loom/machines/lab.internal/
#
# Derive the instance name with `systemd-escape <server-host>`; do not hand-edit
# a `/` or a scheme into it. The worker only makes outbound connections, so a
# machine behind NAT needs no inbound port and no port reservation here — ports
# are a server-side concern (see deploy/README.md § Ports).
#
# There is deliberately NO dependency on loom-server.service: the server may be
# on another machine, and losing it must leave this unit running (and
# reconnecting) rather than stopped.
[Unit]
Description=loom execution worker for server %i
Documentation=file:/usr/share/doc/loom/deploy/README.md https://github.com/550W-HOST/loom/blob/main/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=loom
Group=loom
EnvironmentFile=/etc/loom/worker/%i.env
ExecStart=/usr/local/bin/loom worker
WorkingDirectory=/var/lib/loom/machines/%i

# A worker's whole job is to stay attached. It must come back after a crash, a
# server restart, a network blip and a clean socket close alike. `Restart=always`
# also covers the worker's **self-update**: after a successful install it exits 0
# and this starts the new file. Without a supervisor the worker simply exits
# after an update, which is why the unit is the supported shape
# (docs/upgrades.md § The supervisor is required).
Restart=always
RestartSec=5s

# --- isolation ----------------------------------------------------------
# Deliberately light. The execution plane runs provider CLIs and tools that
# modify workspaces, so filesystem sandboxing (ProtectSystem=strict) would break
# the thing the worker exists to do. The boundary is the dedicated `loom` user
# plus the machine, not a systemd sandbox. Only the cheap, always-safe switches
# are set here.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# --- resource limits (suggestions; size to the machine) -----------------
# This is the process that can genuinely exhaust a host. Cap it hard and let it
# be OOM-killed first: OOMScoreAdjust makes the kernel choose the worker (and
# its provider children) before the control plane or the OS.
MemoryAccounting=true
MemoryMax=8G
CPUAccounting=true
CPUQuota=400%
TasksAccounting=true
TasksMax=8192
LimitNOFILE=65536
OOMScoreAdjust=200

# Stopping the unit stops its provider children with it; a run interrupted this
# way is reported by the server's reaper, and the next start replays from the
# persisted cursor. The host identity itself is persisted immediately at
# startup, so restarts never mint a second host.
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
